# Copiar a .env y completar. .env NO se versiona.
# Los microservicios leen estas variables del entorno:  set -a; . ./.env; set +a

# --- Base de datos (una sola BD, un schema por servicio) ---
DB_HOST=localhost:5433
DB_DATABASE=electorama
DB_USERNAME=electorama
DB_PASSWORD=
# Hibernate valida el schema contra las entidades (geography usa 'none', ver su application.yml)
DDL_AUTO=validate

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=electorama-realm
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/electorama-realm
KEYCLOAK_CLIENT_ID=electorama-back
# Secreto del cliente electorama-back (consola de Keycloak > Clients > electorama-back > Credentials)
KEYCLOAK_CLIENT_SECRET=
# Admin de Keycloak (realm master) que usa msvc-users para administrar usuarios
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# --- Dropbox (canvasandwalls, citizen-issues, documentos, etc.) ---
DROPBOX_ACCESS_TOKEN=
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# --- Google Calendar (msvc-calendar) ---
GOOGLE_CLIENT_SECRET_PATH=file:./secrets/client_secret_gd.json
GOOGLE_CREDENTIALS_PATH=file:./secrets/google-tokens
GOOGLE_REDIRECT_URI=http://localhost:3873/calendar/authGoogle
